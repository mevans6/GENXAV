{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {"source":"/api/consulting/:path*","destination":"/api/consulting?route=:path*"},
    {"source":"/consulting","destination":"/consulting.html"},
    {"source":"/consulting/terms","destination":"/consulting-terms.html"},
    {"source":"/consulting/refunds","destination":"/consulting-refunds.html"},
    {"source":"/consulting/:path*","destination":"/consulting-shell.html"}
  ],
  "headers": [{"source":"/consulting/:path*","headers":[{"key":"Referrer-Policy","value":"no-referrer"},{"key":"X-Robots-Tag","value":"noindex"}]}],
  "crons": [{"path":"/api/consulting/maintenance","schedule":"40 3 * * *"}]
}
