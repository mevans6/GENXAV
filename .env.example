NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Reuse the dedicated home-av-rescue Supabase project, not RiffForge.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: Settings > API Keys in the home-av-rescue Supabase project.
# Paste the legacy service_role key, or a new sb_secret key, below.
SUPABASE_SERVICE_ROLE_KEY=
# Keep the existing signing secret stable to retain access to existing private links.
ACCESS_TOKEN_SECRET=
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=genxav.com
EMAIL_FROM=Gen X AV <intake@genxav.com>
SUPPORT_NOTIFY_EMAIL=consulting@genxav.com
STRIPE_SECRET_KEY=
# New endpoint: https://genxav.com/api/consulting/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
CALENDLY_API_TOKEN=
# Existing prepaid customers: keep this event FREE to avoid charging twice.
CALENDLY_EVENT_TYPE=
# Schedule-first event must be FREE in Calendly, 30 minutes, Zoom only,
# minimum 24-hour notice. The website collects $99 through Stripe afterward.
CALENDLY_RESERVATION_EVENT_TYPE=
# Signed Calendly invitee.created / invitee.canceled webhook endpoint:
# https://genxav.com/api/consulting/webhooks/calendly
CALENDLY_WEBHOOK_SIGNING_KEY=
# Enable only after both webhooks and a five-minute scheduler are verified.
RESERVATION_AUTOMATION_ENABLED=false
# Optional: approved private request UUIDs permitted for sandbox acceptance only.
# Public booking remains disabled when CONSULTATIONS_ENABLED=false.
CONSULTATION_SANDBOX_REQUEST_IDS=
CRON_SECRET=
CONSULTATIONS_ENABLED=false
POLICIES_APPROVED=false
